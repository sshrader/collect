# ---- Server ----
PORT=8787
TRUST_PROXY=1
# Public address of this site, used inside each token's metadata (image + json links). Must stay working for good.
PUBLIC_URL=http://localhost:8787
# Solana RPC (a paid endpoint in production). Empty = the public devnet endpoint.
SOLANA_RPC_URL=
# Shown on the site: devnet or mainnet-beta (the real network is whatever the RPC above points at)
SOLANA_CLUSTER=devnet
# The bonding-curve config every launch uses (made once with `npm run dbc-config`)
DBC_CONFIG=
# Uploaded images, metadata and the token list live here. On Railway: mount a volume and set DATA_DIR=/data
DATA_DIR=./data
# Anti-spam: launches per wallet per hour, and the largest image in bytes
MAX_LAUNCHES_PER_HOUR=3
MAX_IMAGE_BYTES=1000000

# Dev buy and launch fee. The fee (in SOL) pays for drawing the 40 pictures; leave 0 while testing.
# How many collectibles per coin (2 to 40). Use 5 while testing: fewer pictures to draw and fewer buyers to claim.
COLLECTION_SIZE=40
MAX_DEV_BUY_SOL=5
LAUNCH_FEE_SOL=0
LAUNCH_FEE_WALLET=
# Picture drawing: any OpenAI-style images endpoint. Empty key = test placeholders.
IMAGE_API_KEY=
# openai (default), cloudflare (real free tier: ~170 pictures a day) or gemini.
# Cloudflare: IMAGE_PROVIDER=cloudflare, IMAGE_API_KEY=<API token with Workers AI permission>, CLOUDFLARE_ACCOUNT_ID=<your account id>, leave IMAGE_MODEL empty.
CLOUDFLARE_ACCOUNT_ID=
# (older note) Google's image models appear to have NO free tier (a free-tier key gets 429 errors), so use gemini only with billing enabled.
# Check Google's model list for the current image model id; gemini-3.1-flash-lite-image was named as the successor to gemini-2.5-flash-image.
IMAGE_PROVIDER=openai
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high (lower = cheaper). Empty = the service default.
IMAGE_QUALITY=low
# The wallet that creates the NFTs (pays about 0.003 SOL each). Path to a key file, or the JSON array itself. Keep it nearly empty.
AUTHORITY_KEYPAIR=

# ---- Browser (baked in at build time) ----
VITE_CLUSTER=devnet
VITE_RPC_URL=
VITE_DBC_CONFIG=

# ---- Config scripts (run on your PC) ----
PARTNER_KEYPAIR=
DBC_FEE_CLAIMER=
DBC_INITIAL_MC=30
DBC_MIGRATION_MC=300
DBC_FEE_BPS=100
DBC_CREATOR_FEE_PCT=0
